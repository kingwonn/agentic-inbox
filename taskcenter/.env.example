# Task Center secrets. Copy to .env (chmod 600). Values are read via ${VAR} in config/taskcenter.yaml.
# GitHub: a classic PAT with repo + notifications scopes (or leave empty to use the `gh` CLI login)
GITHUB_TOKEN=
# Gmail/IMAP: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
IMAP_USER=
IMAP_PASSWORD=
# Google Calendar: Settings → your calendar → "Secret address in iCal format"
CALENDAR_ICS_URL=
# Telegram bot (talk to @BotFather) + your chat id (send /start to the bot, then check getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy.sh topic (optional push channel)
NTFY_TOPIC=
# SMTP for email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# Dashboard API token (optional; when set, write endpoints require Authorization: Bearer <token>)
TC_API_TOKEN=
# Optional: direct Anthropic API key (only needed for provider=anthropic-api; the default uses your Claude Code login)
ANTHROPIC_API_KEY=
