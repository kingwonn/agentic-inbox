{
  "name": "@agentic-inbox/taskcenter",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI task center: proactive sensing, L1-L5 autonomy, HITL outbox, agent execution, dashboard.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "tc": "./bin/tc.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "dev": "node --no-warnings=ExperimentalWarning --import tsx src/cli.ts",
    "tc": "node --no-warnings=ExperimentalWarning --import tsx src/cli.ts",
    "daemon": "node --no-warnings=ExperimentalWarning --import tsx src/cli.ts daemon",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@hono/node-server": "^1.14.0",
    "croner": "^11.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.0",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
